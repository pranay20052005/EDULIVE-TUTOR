# ============================================================
# EduLive Database Configuration
# Phase 1: Foundation - ENVIRONMENT VARIABLES
# ============================================================

# NEVER commit .env or .env.local with real credentials
# Copy this file to .env.local and fill in your values

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Get these values from your Supabase project settings
# Dashboard: https://supabase.com/dashboard/project/[YOUR-PROJECT]/settings/api

# Supabase Project URL (e.g., https://[PROJECT-ID].supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (safe for browser, limited permissions)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose to browser, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Environment: development, staging, production
VITE_ENVIRONMENT=development

# App URL (for OAuth redirects and CORS)
VITE_APP_URL=http://localhost:5173

# API Base URL (for server-side API calls)
VITE_API_URL=http://localhost:5173/api

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# Enable debug logging in development
VITE_DEBUG=true

# Mock data mode (set to false to use database only)
VITE_MOCK_DATA_ENABLED=true

# ============================================================
# FEATURES
# ============================================================

# Enable real-time subscriptions
VITE_REALTIME_ENABLED=true

# Enable storage for file uploads
VITE_STORAGE_ENABLED=true
