# ============================================================
# EduLive Production Environment Configuration
# ============================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local with production secrets into version control.

# ============================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================
# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public key safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Backend only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Database Password (Required for migration scripts and direct DB pooler)
SUPABASE_DB_PASSWORD=your-db-password-here

# ============================================================
# PAYMENT GATEWAY: RAZORPAY (Required for Checkout & Invoicing)
# ============================================================
# Razorpay Key ID (Safe for frontend checkout component)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Razorpay Key Secret (Server-side HMAC verification and order generation)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Server-side webhook payload verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ============================================================
# AUTHENTICATION & OAUTH PROVIDERS (Optional / SSO)
# ============================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ============================================================
# APPLICATION RUNTIME & URLS
# ============================================================
# Environment: development, staging, production
VITE_ENVIRONMENT=production

# Application URL (for CORS and OAuth callback redirects)
VITE_APP_URL=http://localhost:5173

# API Base URL (for server-side functions and endpoints)
VITE_API_URL=http://localhost:5173/api

# ============================================================
# DATABASE & SYSTEM INTEGRITY FLAGS
# ============================================================
# Realtime WebSocket subscriptions enabled
VITE_REALTIME_ENABLED=true

# Storage integration for course materials, recordings and assignments
VITE_STORAGE_ENABLED=true

# Debug logging (disable in production)
VITE_DEBUG=false
